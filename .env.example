# Local Docker development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/inventory_db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DISABLED=0
ENVIRONMENT=development

# Production: use the Neon pooled connection string, including sslmode=require.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# CORS: add your exact Vercel production domain. The regex allows preview URLs.
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Business details shown on invoices and in the UI.
BUSINESS_NAME=My Business
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_GSTIN=
BUSINESS_STATE=

# GST: default rate is 0. Use GST_MODE=igst for interstate sales.
GST_RATE=0
GST_MODE=cgst_sgst

# Invoice settings.
INVOICE_PREFIX=INV
CURRENCY=INR
PAYMENT_TERMS=
THANK_YOU_MESSAGE=Thank you for your business.

# Application tuning.
DEFAULT_LOW_STOCK_THRESHOLD=5
CACHE_TTL=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
