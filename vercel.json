{
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://billing-inventory-api-4sxg.onrender.com/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
